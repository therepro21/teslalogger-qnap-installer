{
  "templates": [
    {
      "type": 1,
      "title": "TeslaLogger QNAP Manager (Intel/AMD64)",
      "sub_title": "Installation und Webverwaltung fuer TeslaLogger NET8",
      "description": "Installiert und verwaltet den offiziellen TeslaLogger-Mehrcontainer-Stack ueber eine passwortgeschuetzte Weboberflaeche. Ports sind anpassbar und werden vor dem Start auf Konflikte geprueft.",
      "logo": "https://raw.githubusercontent.com/therepro21/teslalogger-qnap-installer/main/assets/teslalogger-qnap.svg",
      "location": "https://github.com/therepro21/teslalogger-qnap-installer",
      "platform": "linux/amd64",
      "image": "ghcr.io/therepro21/teslalogger-qnap-manager:1",
      "env": [
        { "name": "TZ", "value": "Europe/Berlin" }
      ],
      "labels": [
        { "name": "org.opencontainers.image.title", "value": "TeslaLogger QNAP Manager" },
        { "name": "org.opencontainers.image.source", "value": "https://github.com/therepro21/teslalogger-qnap-installer" }
      ],
      "volumes": [
        { "container": "/var/run/docker.sock", "bind": "/var/run/docker.sock" },
        { "container": "/manager-data", "volume": "teslalogger_qnap_manager_data" },
        { "container": "/backups", "volume": "teslalogger_qnap_backups" }
      ],
      "ports": ["8080/tcp"],
      "restart_policy": "unless-stopped",
      "interactive": false,
      "tty": false,
      "privileged": false
    },
    {
      "type": 1,
      "title": "TeslaLogger QNAP Manager (ARM64)",
      "sub_title": "Installation und Webverwaltung fuer TeslaLogger NET8",
      "description": "Installiert und verwaltet den offiziellen TeslaLogger-Mehrcontainer-Stack inklusive ARM64-Karten-Workaround ueber eine passwortgeschuetzte Weboberflaeche. Ports sind anpassbar und werden auf Konflikte geprueft.",
      "logo": "https://raw.githubusercontent.com/therepro21/teslalogger-qnap-installer/main/assets/teslalogger-qnap.svg",
      "location": "https://github.com/therepro21/teslalogger-qnap-installer",
      "platform": "linux/arm64",
      "image": "ghcr.io/therepro21/teslalogger-qnap-manager:1",
      "env": [
        { "name": "TZ", "value": "Europe/Berlin" }
      ],
      "labels": [
        { "name": "org.opencontainers.image.title", "value": "TeslaLogger QNAP Manager" },
        { "name": "org.opencontainers.image.source", "value": "https://github.com/therepro21/teslalogger-qnap-installer" }
      ],
      "volumes": [
        { "container": "/var/run/docker.sock", "bind": "/var/run/docker.sock" },
        { "container": "/manager-data", "volume": "teslalogger_qnap_manager_data" },
        { "container": "/backups", "volume": "teslalogger_qnap_backups" }
      ],
      "ports": ["8080/tcp"],
      "restart_policy": "unless-stopped",
      "interactive": false,
      "tty": false,
      "privileged": false
    }
  ]
}
